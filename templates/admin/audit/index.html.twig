{% extends 'base.html.twig' %}

{% block title %}Audit Log{% endblock %}

{% block body %}
<h1 class="h3 mb-4">Audit Log</h1>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>ID</th>
                    <th>Changes</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    <tr>
                        <td>{{ log.createdAt|datetime_fmt }}</td>
                        <td>{{ log.user ? log.user.email : '—' }}</td>
                        <td><span class="badge bg-light text-dark border">{{ log.action }}</span></td>
                        <td>{{ log.entity }}</td>
                        <td>{{ log.entityId ?? '—' }}</td>
                        <td style="min-width: 220px;">
                            {% if log.changes|length > 0 %}
                                <div class="d-flex flex-column gap-1">
                                    {% for key, value in log.changes %}
                                        <div class="d-flex gap-2">
                                            <span class="text-muted small text-nowrap" style="width: 110px;">{{ key|replace({'_': ' '})|capitalize }}:</span>
                                            <code class="small">{{ value is iterable ? value|join(', ') : value }}</code>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>{{ log.ip ?? '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center text-muted py-4">No audit entries yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
