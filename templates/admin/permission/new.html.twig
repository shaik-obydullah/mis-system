{% extends 'base.html.twig' %}

{% block title %}New Permission{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">New Permission</h1>
    <a href="{{ path('admin_permissions') }}" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <form method="post" action="{{ path('admin_permission_new') }}">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="name" class="form-label">Name *</label>
                    <input type="text" id="name" name="name" class="form-control" placeholder="order.create" required>
                    <div class="form-text">e.g. order.create, product.manage</div>
                </div>
                <div class="col-md-6">
                    <label for="label" class="form-label">Label *</label>
                    <input type="text" id="label" name="label" class="form-control" placeholder="Create orders" required>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Create permission</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
