{% extends 'base.html.twig' %}

{% block title %}Settings{% endblock %}

{% block body %}
<h1 class="h3 mb-4">Settings</h1>

<div class="card shadow-sm" style="max-width: 700px;">
    <div class="card-body">
        <form method="post" action="{{ path('admin_settings') }}">
            <div class="row g-3">
                <div class="col-12">
                    <label for="business_name" class="form-label">Business name</label>
                    <input type="text" id="business_name" name="business_name" value="{{ values.business_name }}" class="form-control">
                </div>
                <div class="col-md-4">
                    <label for="currency" class="form-label">Currency</label>
                    <input type="text" id="currency" name="currency" value="{{ values.currency }}" class="form-control" placeholder="USD">
                </div>
                <div class="col-md-4">
                    <label for="timezone" class="form-label">Timezone</label>
                    <input type="text" id="timezone" name="timezone" value="{{ values.timezone }}" class="form-control" placeholder="UTC">
                </div>
                <div class="col-md-4">
                    <label for="tax_rate" class="form-label">Tax rate (%)</label>
                    <input type="number" step="0.01" min="0" id="tax_rate" name="tax_rate" value="{{ values.tax_rate }}" class="form-control">
                </div>
                <div class="col-12">
                    <label for="daily_summary_email" class="form-label">Daily summary email</label>
                    <input type="email" id="daily_summary_email" name="daily_summary_email" value="{{ values.daily_summary_email }}" class="form-control">
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save settings</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
