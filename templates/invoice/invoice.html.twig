<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Invoice {{ order.orderNo }}</title>
    <style>
        body { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #222; margin: 40px; }
        h1 { font-size: 22px; margin: 0 0 4px; }
        .muted { color: #666; }
        table { width: 100%; border-collapse: collapse; margin-top: 24px; }
        th, td { padding: 6px 8px; border: 1px solid #ddd; text-align: left; }
        th { background: #f5f5f5; }
        .text-right { text-align: right; }
        .totals td { border: none; }
        .grand-total td { border-top: 2px solid #222; font-weight: bold; font-size: 13px; }
        .meta { margin-top: 8px; }
        .footer { margin-top: 48px; color: #888; font-size: 10px; }
    </style>
</head>
<body>
    <table style="border: none;">
        <tr>
            <td style="border: none;">
                <h1>{{ business.name }}</h1>
                <div class="muted">Restaurant Management System</div>
            </td>
            <td style="border: none; text-align: right;">
                <strong>INVOICE</strong><br>
                <span class="muted">{{ order.orderNo }}</span>
            </td>
        </tr>
    </table>

    <div class="meta">
        <strong>Date:</strong> {{ order.createdAt|datetime_fmt }}<br>
        <strong>Customer:</strong> {{ order.customer ?? 'Walk-in customer' }}<br>
        <strong>Cashier:</strong> {{ order.createdBy.fullName }}<br>
        <strong>Status:</strong> {{ order.status|capitalize }}
    </div>

    <table>
        <thead>
            <tr>
                <th>Product</th>
                <th class="text-right">Qty</th>
                <th class="text-right">Unit price</th>
                <th class="text-right">Line total</th>
            </tr>
        </thead>
        <tbody>
            {% for item in order.items %}
                <tr>
                    <td>{{ item.product.name }} <span class="muted">({{ item.product.sku }})</span></td>
                    <td class="text-right">{{ item.quantity }}</td>
                    <td class="text-right">{{ business.currency }} {{ item.unitPrice|number_format(2) }}</td>
                    <td class="text-right">{{ business.currency }} {{ item.lineTotal|number_format(2) }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <table class="totals" style="float: right; width: 40%; margin-top: 8px;">
        <tr>
            <td class="text-right">Subtotal</td>
            <td class="text-right">{{ business.currency }} {{ order.subtotal|number_format(2) }}</td>
        </tr>
        <tr>
            <td class="text-right">Tax</td>
            <td class="text-right">{{ business.currency }} {{ order.tax|number_format(2) }}</td>
        </tr>
        <tr class="grand-total">
            <td class="text-right">Total</td>
            <td class="text-right">{{ business.currency }} {{ order.total|number_format(2) }}</td>
        </tr>
    </table>

    <div class="footer">Thank you for your business. Generated {{ 'now'|datetime_fmt }}.</div>
</body>
</html>
