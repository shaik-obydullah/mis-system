{% extends 'base.html.twig' %}

{% block title %}Reports{% endblock %}

{% block page_title %}Reports{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="page-heading mb-0">
        <h1 class="h3">Reports</h1>
        <p class="lead">{{ from }} → {{ to }}</p>
    </div>
    <a href="{{ path('report_export', app.request.query.all) }}" class="btn btn-outline-secondary"><i class="bi bi-download me-1"></i>Export CSV</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('report_index') }}" class="row g-2 align-items-end">
            <div class="col-auto">
                <label for="from" class="form-label small mb-1">From</label>
                <input type="date" id="from" name="from" value="{{ from }}" class="form-control">
            </div>
            <div class="col-auto">
                <label for="to" class="form-label small mb-1">To</label>
                <input type="date" id="to" name="to" value="{{ to }}" class="form-control">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Generate</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-indigo"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="stat-label">Sales</div>
                <div class="stat-value fs-4">{{ report.sales|money }}</div>
                <div class="stat-sub">{{ report.orders }} order(s)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-slate"><i class="bi bi-boxes"></i></div>
            <div>
                <div class="stat-label">COGS</div>
                <div class="stat-value fs-4">{{ report.cogs|money }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-emerald"><i class="bi bi-graph-up-arrow"></i></div>
            <div>
                <div class="stat-label">Gross profit</div>
                <div class="stat-value fs-4 text-success">{{ report.gross_profit|money }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-rose"><i class="bi bi-wallet2"></i></div>
            <div>
                <div class="stat-label">Expenses</div>
                <div class="stat-value fs-4 text-danger">{{ report.expenses|money }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-amber"><i class="bi bi-piggy-bank"></i></div>
            <div>
                <div class="stat-label">Net profit</div>
                <div class="stat-value fs-4">{{ report.net_profit|money }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-sky"><i class="bi bi-percent"></i></div>
            <div>
                <div class="stat-label">Gross margin</div>
                <div class="stat-value fs-4">{{ report.sales > 0 ? (report.gross_profit / report.sales * 100)|round(1) : 0 }}%</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">Sales by day</div>
            <div class="card-body" style="height: 300px;">
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Sales by category</div>
            <div class="card-body" style="height: 300px;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Expenses by category</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in expenseBreakdown %}
                            <tr>
                                <td>{{ row.category }}</td>
                                <td class="text-end fw-semibold">{{ row.total|money }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="2" class="text-center text-muted py-4">No expenses in range.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Top products</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Qty sold</th>
                            <th class="text-end">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in topProducts %}
                            <tr>
                                <td>{{ row.name }}</td>
                                <td class="text-end">{{ row.qty }}</td>
                                <td class="text-end fw-semibold">{{ row.revenue|money }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="text-center text-muted py-4">No sales in range.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Inventory valuation</span>
        <span class="text-muted fw-normal small">Stock on hand × unit cost</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Unit cost</th>
                    <th class="text-end">Value</th>
                </tr>
            </thead>
            <tbody>
                {% set inv_total = 0 %}
                {% for row in inventory %}
                    {% set inv_total = inv_total + row.value %}
                    <tr>
                        <td>{{ row.name }}</td>
                        <td><code>{{ row.sku }}</code></td>
                        <td class="text-end">{{ row.stock }}</td>
                        <td class="text-end">{{ row.cost|money }}</td>
                        <td class="text-end fw-semibold">{{ row.value|money }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">No products in inventory.</td></tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="4" class="text-end">Total inventory value</td>
                    <td class="text-end">{{ inv_total|money }}</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
    Chart.defaults.color = '#64748b';

    const salesLabels = {{ salesByDay|map(d => d.date)|json_encode|raw }};
    const salesData = {{ salesByDay|map(d => d.total)|json_encode|raw }};

    new Chart(document.getElementById('salesChart'), {
        type: 'bar',
        data: {
            labels: salesLabels,
            datasets: [{
                label: 'Sales',
                data: salesData,
                backgroundColor: 'rgba(79, 70, 229, 0.7)',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(148, 163, 184, 0.15)' }, border: { display: false } },
                x: { grid: { display: false }, border: { display: false } }
            }
        }
    });

    const catLabels = {{ salesByCategory|map(c => c.category)|json_encode|raw }};
    const catData = {{ salesByCategory|map(c => c.total)|json_encode|raw }};

    new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut',
        data: {
            labels: catLabels,
            datasets: [{
                data: catData,
                backgroundColor: ['#4f46e5', '#10b981', '#f59e0b', '#f43f5e', '#0ea5e9', '#8b5cf6', '#f97316', '#14b8a6'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '68%',
            plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 14 } } }
        }
    });
</script>
{% endblock %}
