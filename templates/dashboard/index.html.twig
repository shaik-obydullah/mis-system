{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="row g-4 mb-4">
    <div class="col-6 col-md-4 col-xxl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-indigo"><i class="bi bi-cash-coin"></i></div>
            <div>
                <div class="stat-label">Today's Sales</div>
                <div class="stat-value">{{ dashboard.today_sales|money }}</div>
                <div class="stat-sub">{{ dashboard.today_orders }} order(s)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xxl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-emerald"><i class="bi bi-graph-up-arrow"></i></div>
            <div>
                <div class="stat-label">Today's Profit</div>
                <div class="stat-value">{{ dashboard.today_profit|money }}</div>
                <div class="stat-sub">Expenses: {{ dashboard.today_expenses|money }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xxl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-sky"><i class="bi bi-calendar3"></i></div>
            <div>
                <div class="stat-label">Month Sales</div>
                <div class="stat-value">{{ dashboard.month_sales|money }}</div>
                <div class="stat-sub">{{ dashboard.month_orders }} order(s)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xxl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-amber"><i class="bi bi-piggy-bank"></i></div>
            <div>
                <div class="stat-label">Month Profit</div>
                <div class="stat-value">{{ dashboard.month_profit|money }}</div>
                <div class="stat-sub">Expenses: {{ dashboard.month_expenses|money }}</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xxl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-rose"><i class="bi bi-exclamation-triangle"></i></div>
            <div>
                <div class="stat-label">Low Stock</div>
                <div class="stat-value {{ dashboard.low_stock_count > 0 ? 'text-danger' : '' }}">{{ dashboard.low_stock_count }}</div>
                <div class="stat-sub">items below threshold</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xxl-2">
        <div class="stat-card">
            <div class="stat-icon stat-icon-slate"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="stat-label">Month COGS</div>
                <div class="stat-value">{{ dashboard.cogs|money }}</div>
                <div class="stat-sub">cost of goods sold</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">Sales — last 14 days</div>
            <div class="card-body" style="height: 320px;">
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">Sales by category — this month</div>
            <div class="card-body" style="height: 320px;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent orders</span>
                <a href="{{ path('order_index') }}" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th class="text-end">Total</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in recentOrders %}
                            <tr>
                                <td><a href="{{ path('order_show', {'id': order.id}) }}">{{ order.orderNo }}</a></td>
                                <td>{{ order.customer ?? '—' }}</td>
                                <td>
                                    {% if order.status == 'paid' %}<span class="badge bg-success">Paid</span>
                                    {% elseif order.status == 'open' %}<span class="badge bg-warning">Open</span>
                                    {% elseif order.status == 'cancelled' %}<span class="badge bg-secondary">Cancelled</span>
                                    {% elseif order.status == 'refunded' %}<span class="badge bg-danger">Refunded</span>
                                    {% endif %}
                                </td>
                                <td class="text-end fw-semibold">{{ order.total|money }}</td>
                                <td>{{ order.createdAt|datetime_fmt }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center text-muted py-4">No orders yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Low stock</span>
                <a href="{{ path('product_index') }}" class="btn btn-sm btn-outline-secondary">Products</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Stock</th>
                            <th class="text-end">Threshold</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in lowStock %}
                            <tr>
                                <td>{{ product.name }}</td>
                                <td class="text-end text-danger fw-semibold">{{ product.currentStock }}</td>
                                <td class="text-end">{{ product.lowStockThreshold }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="text-center text-muted py-4">All stocked up.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
    Chart.defaults.color = '#64748b';

    const salesLabels = {{ salesByDay|map(d => d.date)|json_encode|raw }};
    const salesData = {{ salesByDay|map(d => d.total)|json_encode|raw }};

    new Chart(document.getElementById('salesChart'), {
        type: 'line',
        data: {
            labels: salesLabels,
            datasets: [{
                label: 'Sales',
                data: salesData,
                borderColor: '#4f46e5',
                backgroundColor: 'rgba(79, 70, 229, 0.12)',
                fill: true,
                tension: 0.35,
                pointRadius: 3,
                pointBackgroundColor: '#4f46e5',
                borderWidth: 2.5
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(148, 163, 184, 0.15)' }, border: { display: false } },
                x: { grid: { display: false }, border: { display: false } }
            }
        }
    });

    const catLabels = {{ salesByCategory|map(c => c.category)|json_encode|raw }};
    const catData = {{ salesByCategory|map(c => c.total)|json_encode|raw }};

    new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut',
        data: {
            labels: catLabels,
            datasets: [{
                data: catData,
                backgroundColor: ['#4f46e5', '#10b981', '#f59e0b', '#f43f5e', '#0ea5e9', '#8b5cf6', '#f97316', '#14b8a6'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '68%',
            plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 14 } } }
        }
    });
</script>
{% endblock %}
