{% extends 'base.html.twig' %}

{% block title %}Edit {{ product.name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Edit {{ product.name }}</h1>
    <a href="{{ path('product_index') }}" class="btn btn-outline-secondary">Back</a>
</div>

<form method="post" action="{{ path('product_edit', {'id': product.id}) }}">
    {% include 'inventory/product/_form.html.twig' %}
    <button type="submit" class="btn btn-primary">Save changes</button>
</form>
{% endblock %}
