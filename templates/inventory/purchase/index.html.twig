{% extends 'base.html.twig' %}

{% block title %}Purchases{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Purchases</h1>
    <a href="{{ path('purchase_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New purchase</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Supplier</th>
                    <th class="text-end">Total</th>
                    <th>Note</th>
                    <th>Created by</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for purchase in purchases %}
                    <tr>
                        <td><a href="{{ path('purchase_show', {'id': purchase.id}) }}">PUR-{{ purchase.id }}</a></td>
                        <td>{{ purchase.supplier ? purchase.supplier.name : '—' }}</td>
                        <td class="text-end">{{ purchase.total|money }}</td>
                        <td>{{ purchase.note ?? '—' }}</td>
                        <td>{{ purchase.createdBy.fullName }}</td>
                        <td>{{ purchase.createdAt|date('Y-m-d H:i') }}</td>
                        <td class="text-end">
                            <a href="{{ path('purchase_show', {'id': purchase.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center text-muted py-4">No purchases yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
