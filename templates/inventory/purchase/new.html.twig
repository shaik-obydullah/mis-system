{% extends 'base.html.twig' %}

{% block title %}New Purchase{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">New Purchase</h1>
    <a href="{{ path('purchase_index') }}" class="btn btn-outline-secondary">Back</a>
</div>

<form method="post" action="{{ path('purchase_new') }}">
    <div class="card shadow-sm mb-3">
        <div class="card-header">Purchase details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="supplier" class="form-label">Supplier</label>
                    <select id="supplier" name="supplier" class="form-select">
                        <option value="">— None —</option>
                        {% for s in suppliers %}
                            <option value="{{ s.id }}">{{ s.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="note" class="form-label">Note</label>
                    <input type="text" id="note" name="note" class="form-control">
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Items</span>
            <button type="button" class="btn btn-sm btn-outline-primary" id="addLine"><i class="bi bi-plus-lg me-1"></i>Add item</button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th style="width: 140px;">Quantity</th>
                            <th style="width: 140px;">Unit cost</th>
                            <th style="width: 160px;" class="text-end">Line total</th>
                            <th style="width: 60px;"></th>
                        </tr>
                    </thead>
                    <tbody id="lines">
                        <tr class="line-row">
                            <td>
                                <select name="product_id[]" class="form-select product-select">
                                    <option value="">— Select product —</option>
                                    {% for p in products %}
                                        <option value="{{ p.id }}">{{ p.name }} ({{ p.sku }})</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td><input type="number" name="quantity[]" class="form-control quantity-input" value="1" min="0.001" step="0.001" required></td>
                            <td><input type="number" name="unit_cost[]" class="form-control cost-input" value="0.00" min="0.01" step="0.01" required></td>
                            <td class="text-end line-total fw-semibold">0.00</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger remove-line"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row justify-content-end">
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td class="text-muted">Subtotal</td>
                                <td class="text-end fw-semibold" id="summarySubtotal">{{ settings.get('currency', 'USD') }} 0.00</td>
                            </tr>
                            <tr class="border-top">
                                <td class="fw-bold">Total</td>
                                <td class="text-end fs-5 fw-bold" id="summaryTotal">{{ settings.get('currency', 'USD') }} 0.00</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Record purchase</button>
    </div>
</form>
{% endblock %}

{% block javascripts %}
<script>
    const currency = '{{ settings.get('currency', 'USD') }}';
    const addLineBtn = document.getElementById('addLine');
    const lines = document.getElementById('lines');

    function fmt(value) {
        return currency + ' ' + value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function recalc() {
        let subtotal = 0;
        document.querySelectorAll('.line-row').forEach(row => {
            const qty = parseFloat(row.querySelector('.quantity-input').value) || 0;
            const cost = parseFloat(row.querySelector('.cost-input').value) || 0;
            const total = qty * cost;
            row.querySelector('.line-total').textContent = fmt(total);
            subtotal += total;
        });
        document.getElementById('summarySubtotal').textContent = fmt(subtotal);
        document.getElementById('summaryTotal').textContent = fmt(subtotal);
    }

    addLineBtn.addEventListener('click', () => {
        const row = document.createElement('tr');
        row.className = 'line-row';
        row.innerHTML = `
            <td>
                <select name="product_id[]" class="form-select product-select">
                    <option value="">— Select product —</option>
                    {% for p in products %}
                        <option value="{{ p.id }}">{{ p.name }} ({{ p.sku }})</option>
                    {% endfor %}
                </select>
            </td>
            <td><input type="number" name="quantity[]" class="form-control quantity-input" value="1" min="0.001" step="0.001" required></td>
            <td><input type="number" name="unit_cost[]" class="form-control cost-input" value="0.00" min="0.01" step="0.01" required></td>
            <td class="text-end line-total fw-semibold">0.00</td>
            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger remove-line"><i class="bi bi-trash"></i></button></td>`;
        lines.appendChild(row);
        recalc();
    });

    lines.addEventListener('click', (event) => {
        if (event.target.closest('.remove-line')) {
            const rows = document.querySelectorAll('.line-row');
            if (rows.length > 1) {
                event.target.closest('.line-row').remove();
                recalc();
            }
        }
    });

    lines.addEventListener('input', (event) => {
        if (event.target.matches('.quantity-input, .cost-input')) {
            recalc();
        }
    });
</script>
{% endblock %}
