{% extends 'base.html.twig' %}

{% block title %}Salaries{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Salaries</h1>
    <a href="{{ path('salary_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Record salary</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Period</th>
                    <th class="text-end">Amount</th>
                    <th>Paid at</th>
                    <th>Recorded by</th>
                </tr>
            </thead>
            <tbody>
                {% for salary in salaries %}
                    <tr>
                        <td>{{ salary.employee.name }}</td>
                        <td>{{ salary.period }}</td>
                        <td class="text-end">{{ salary.amount|money }}</td>
                        <td>{{ salary.paidAt ? salary.paidAt|date('Y-m-d') : '—' }}</td>
                        <td>{{ salary.createdBy.fullName }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">No salary records yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
