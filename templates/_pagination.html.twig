{% if pagination.pages > 1 %}
<nav aria-label="Pagination">
    <ul class="pagination pagination-sm justify-content-center mb-0">
        {% set page = pagination.page %}
        {% set query = app.request.query.all %}
        <li class="page-item {{ page <= 1 ? 'disabled' }}">
            <a class="page-link" href="{{ path(route, query|merge({'page': page - 1})) }}"><i class="bi bi-chevron-left"></i></a>
        </li>
        {% for p in range(1, pagination.pages) %}
            {% if p == page or p == 1 or p == pagination.pages or (p >= page - 2 and p <= page + 2) %}
                <li class="page-item {{ p == page ? 'active' }}">
                    <a class="page-link" href="{{ path(route, query|merge({'page': p})) }}">{{ p }}</a>
                </li>
            {% elseif p == page - 3 or p == page + 3 %}
                <li class="page-item disabled"><span class="page-link">…</span></li>
            {% endif %}
        {% endfor %}
        <li class="page-item {{ page >= pagination.pages ? 'disabled' }}">
            <a class="page-link" href="{{ path(route, query|merge({'page': page + 1})) }}"><i class="bi bi-chevron-right"></i></a>
        </li>
    </ul>
</nav>
{% endif %}
