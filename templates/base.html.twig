<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ settings.get('business_name', 'MIS System') }}{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">
{% if app.user is not null %}
    <div class="d-flex min-vh-100">
        <nav class="d-flex flex-column flex-shrink-0 p-3 bg-dark text-white" style="width: 250px;">
            <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                <span class="fs-5 fw-semibold"><i class="bi bi-shop me-2"></i>{{ settings.get('business_name', 'MIS System') }}</span>
            </a>
            <hr class="text-secondary">
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="{{ path('app_dashboard') }}" class="nav-link text-white {% if app.request.attributes.get('_route') == 'app_dashboard' %}active bg-primary{% endif %}">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('order_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'order_' %}active bg-primary{% endif %}">
                        <i class="bi bi-receipt me-2"></i>Orders
                    </a>
                </li>
                {% if is_granted('ROLE_MANAGER') %}
                    <li class="nav-header text-uppercase text-secondary small mt-3 mb-1 px-2">Inventory</li>
                    <li class="nav-item">
                        <a href="{{ path('product_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'product_' %}active bg-primary{% endif %}">
                            <i class="bi bi-box-seam me-2"></i>Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('product_category_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') == 'product_category_index' %}active bg-primary{% endif %}">
                            <i class="bi bi-tags me-2"></i>Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('supplier_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'supplier_' %}active bg-primary{% endif %}">
                            <i class="bi bi-truck me-2"></i>Suppliers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('purchase_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'purchase_' %}active bg-primary{% endif %}">
                            <i class="bi bi-cart-plus me-2"></i>Purchases
                        </a>
                    </li>
                    <li class="nav-header text-uppercase text-secondary small mt-3 mb-1 px-2">Expenses</li>
                    <li class="nav-item">
                        <a href="{{ path('expense_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') == 'expense_index' or app.request.attributes.get('_route') == 'expense_new' %}active bg-primary{% endif %}">
                            <i class="bi bi-wallet2 me-2"></i>Expenses
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('expense_category_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'expense_category_' %}active bg-primary{% endif %}">
                            <i class="bi bi-tag me-2"></i>Categories
                        </a>
                    </li>
                    <li class="nav-header text-uppercase text-secondary small mt-3 mb-1 px-2">Staff</li>
                    <li class="nav-item">
                        <a href="{{ path('employee_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'employee_' %}active bg-primary{% endif %}">
                            <i class="bi bi-people me-2"></i>Employees
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('attendance_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'attendance_' %}active bg-primary{% endif %}">
                            <i class="bi bi-calendar-check me-2"></i>Attendance
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('salary_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'salary_' %}active bg-primary{% endif %}">
                            <i class="bi bi-cash-stack me-2"></i>Salaries
                        </a>
                    </li>
                    <li class="nav-header text-uppercase text-secondary small mt-3 mb-1 px-2">Reports</li>
                    <li class="nav-item">
                        <a href="{{ path('report_index') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'report_' %}active bg-primary{% endif %}">
                            <i class="bi bi-graph-up me-2"></i>Reports
                        </a>
                    </li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-header text-uppercase text-secondary small mt-3 mb-1 px-2">Administration</li>
                    <li class="nav-item">
                        <a href="{{ path('admin_users') }}" class="nav-link text-white {% if app.request.attributes.get('_route') starts with 'admin_user' %}active bg-primary{% endif %}">
                            <i class="bi bi-person-gear me-2"></i>Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_settings') }}" class="nav-link text-white {% if app.request.attributes.get('_route') == 'admin_settings' %}active bg-primary{% endif %}">
                            <i class="bi bi-gear me-2"></i>Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_audit') }}" class="nav-link text-white {% if app.request.attributes.get('_route') == 'admin_audit' %}active bg-primary{% endif %}">
                            <i class="bi bi-journal-text me-2"></i>Audit Log
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>
        <div class="d-flex flex-column flex-grow-1">
            <nav class="navbar navbar-expand bg-white border-bottom px-3 py-2">
                <div class="container-fluid">
                    <div class="d-flex align-items-center ms-auto">
                        <a href="{{ path('notification_index') }}" class="btn btn-sm btn-outline-secondary position-relative me-2" title="Notifications">
                            <i class="bi bi-bell"></i>
                            {% if notification_service.unreadCount() > 0 %}
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">{{ notification_service.unreadCount() }}</span>
                            {% endif %}
                        </a>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>{{ app.user.fullName }}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text text-muted small">{{ app.user.email }}</span></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="{{ path('app_logout') }}" method="post">
                                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
            <main class="p-4">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
                {{ block('body') }}
            </main>
        </div>
    </div>
{% else %}
    {{ block('body') }}
{% endif %}
{% block body %}{% endblock %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
