<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ settings.get('business_name', 'MIS System') }}{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;750;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('css/app.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% if app.user is not null %}
    <div class="app-shell">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <div class="brand-logo"><i class="bi bi-shop"></i></div>
                <div class="brand-text">
                    <span class="brand-name">{{ settings.get('business_name', 'MIS System') }}</span>
                    <span class="brand-sub">Management System</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <ul>
                    <li><a href="{{ path('app_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                        <i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
                    </li>
                    <li><a href="{{ path('order_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'order_' %}active{% endif %}">
                        <i class="bi bi-receipt"></i><span>Orders</span></a>
                    </li>

                    {% if is_granted('ROLE_MANAGER') %}
                        <li class="nav-section">Inventory</li>
                        <li><a href="{{ path('product_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'product_' %}active{% endif %}">
                            <i class="bi bi-box-seam"></i><span>Products</span></a>
                        </li>
                        <li><a href="{{ path('product_category_index') }}" class="nav-link {% if app.request.attributes.get('_route') == 'product_category_index' %}active{% endif %}">
                            <i class="bi bi-tags"></i><span>Categories</span></a>
                        </li>
                        <li><a href="{{ path('supplier_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'supplier_' %}active{% endif %}">
                            <i class="bi bi-truck"></i><span>Suppliers</span></a>
                        </li>
                        <li><a href="{{ path('purchase_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'purchase_' %}active{% endif %}">
                            <i class="bi bi-cart-plus"></i><span>Purchases</span></a>
                        </li>

                        <li class="nav-section">Expenses</li>
                        <li><a href="{{ path('expense_index') }}" class="nav-link {% if app.request.attributes.get('_route') == 'expense_index' or app.request.attributes.get('_route') == 'expense_new' %}active{% endif %}">
                            <i class="bi bi-wallet2"></i><span>Expenses</span></a>
                        </li>
                        <li><a href="{{ path('expense_category_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'expense_category_' %}active{% endif %}">
                            <i class="bi bi-tag"></i><span>Categories</span></a>
                        </li>

                        <li class="nav-section">Staff</li>
                        <li><a href="{{ path('employee_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'employee_' %}active{% endif %}">
                            <i class="bi bi-people"></i><span>Employees</span></a>
                        </li>
                        <li><a href="{{ path('attendance_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'attendance_' %}active{% endif %}">
                            <i class="bi bi-calendar-check"></i><span>Attendance</span></a>
                        </li>
                        <li><a href="{{ path('salary_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'salary_' %}active{% endif %}">
                            <i class="bi bi-cash-stack"></i><span>Salaries</span></a>
                        </li>

                        <li class="nav-section">Reports</li>
                        <li><a href="{{ path('report_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'report_' %}active{% endif %}">
                            <i class="bi bi-graph-up-arrow"></i><span>Reports</span></a>
                        </li>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-section">Administration</li>
                        <li><a href="{{ path('admin_users') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'admin_user' %}active{% endif %}">
                            <i class="bi bi-person-gear"></i><span>Users</span></a>
                        </li>
                        <li><a href="{{ path('admin_settings') }}" class="nav-link {% if app.request.attributes.get('_route') == 'admin_settings' %}active{% endif %}">
                            <i class="bi bi-gear"></i><span>Settings</span></a>
                        </li>
                        <li><a href="{{ path('admin_audit') }}" class="nav-link {% if app.request.attributes.get('_route') == 'admin_audit' %}active{% endif %}">
                            <i class="bi bi-journal-text"></i><span>Audit Log</span></a>
                        </li>
                    {% endif %}
                </ul>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="avatar">{{ app.user.fullName|slice(0, 1)|upper }}</div>
                    <div class="user-meta">
                        <span class="user-name">{{ app.user.fullName }}</span>
                        <span class="user-role">{{ app.user.role|replace({'ROLE_': ''})|lower|capitalize }}</span>
                    </div>
                    <form action="{{ path('app_logout') }}" method="post">
                        <button type="submit" class="btn-icon" title="Logout"><i class="bi bi-box-arrow-right"></i></button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-left">
                    <button type="button" class="btn-icon topbar-toggle" id="sidebarToggle" aria-label="Toggle sidebar"><i class="bi bi-list"></i></button>
                    <div class="topbar-title">{% block page_title %}{% endblock %}</div>
                </div>
                <div class="topbar-right">
                    <a href="{{ path('notification_index') }}" class="btn-icon" title="Notifications">
                        <i class="bi bi-bell"></i>
                        {% if notification_service.unreadCount() > 0 %}
                            <span class="position-absolute top-0 start-100 translate-middle badge bg-danger">{{ notification_service.unreadCount() }}</span>
                        {% endif %}
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 py-1 px-2" data-bs-toggle="dropdown" style="border: none;">
                            <span class="avatar" style="width: 30px; height: 30px; font-size: 0.8rem;">{{ app.user.fullName|slice(0, 1)|upper }}</span>
                            <span class="d-none d-md-inline">{{ app.user.fullName }}</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text text-muted small">{{ app.user.email }}</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form action="{{ path('app_logout') }}" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
                {{ block('body') }}
            </main>
        </div>
    </div>

    <script>
        const sidebar = document.getElementById('appSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const toggle = document.getElementById('sidebarToggle');

        function closeSidebar() {
            sidebar.classList.remove('is-open');
            backdrop.classList.remove('is-open');
        }

        toggle.addEventListener('click', () => {
            const open = sidebar.classList.toggle('is-open');
            backdrop.classList.toggle('is-open', open);
        });

        backdrop.addEventListener('click', closeSidebar);
        sidebar.querySelectorAll('.nav-link').forEach(link => link.addEventListener('click', closeSidebar));
    </script>
{% else %}
    {{ block('body') }}
{% endif %}
{% block body %}{% endblock %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
