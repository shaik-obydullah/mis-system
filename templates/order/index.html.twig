{% extends 'base.html.twig' %}

{% block title %}Orders{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="page-heading mb-0">
        <h1 class="h3">Orders</h1>
        <p class="lead">{{ pagination.total }} order(s)</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('order_export', app.request.query.all) }}" class="btn btn-outline-secondary"><i class="bi bi-download me-1"></i>Export CSV</a>
        <a href="{{ path('order_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New order</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('order_index') }}" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label for="q" class="form-label small mb-1">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="q" name="q" value="{{ filters.q }}" class="form-control" placeholder="Order no or customer…">
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label for="from" class="form-label small mb-1">From</label>
                <input type="date" id="from" name="from" value="{{ filters.from }}" class="form-control">
            </div>
            <div class="col-6 col-md-2">
                <label for="to" class="form-label small mb-1">To</label>
                <input type="date" id="to" name="to" value="{{ filters.to }}" class="form-control">
            </div>
            <div class="col-6 col-md-2">
                <label for="status" class="form-label small mb-1">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All</option>
                    <option value="open" {% if filters.status == 'open' %}selected{% endif %}>Open</option>
                    <option value="paid" {% if filters.status == 'paid' %}selected{% endif %}>Paid</option>
                    <option value="cancelled" {% if filters.status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                    <option value="refunded" {% if filters.status == 'refunded' %}selected{% endif %}>Refunded</option>
                </select>
            </div>
            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">Filter</button>
                <a href="{{ path('order_index') }}" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th class="text-end">Total</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for order in orders %}
                    <tr>
                        <td><a href="{{ path('order_show', {'id': order.id}) }}">{{ order.orderNo }}</a></td>
                        <td>{{ order.customer ?? '—' }}</td>
                        <td>
                            {% if order.status == 'paid' %}<span class="badge bg-success">Paid</span>
                            {% elseif order.status == 'open' %}<span class="badge bg-warning">Open</span>
                            {% elseif order.status == 'cancelled' %}<span class="badge bg-secondary">Cancelled</span>
                            {% elseif order.status == 'refunded' %}<span class="badge bg-danger">Refunded</span>
                            {% endif %}
                        </td>
                        <td>{{ order.paymentMethod ? order.paymentMethod|capitalize : '—' }}</td>
                        <td class="text-end fw-semibold">{{ order.total|money }}</td>
                        <td>{{ order.createdAt|datetime_fmt }}</td>
                        <td class="text-end">
                            <a href="{{ path('order_show', {'id': order.id}) }}" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                            <a href="{{ path('order_invoice', {'id': order.id}) }}" class="btn btn-sm btn-outline-primary" target="_blank" title="Invoice"><i class="bi bi-file-pdf"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center text-muted py-4">No orders found.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if pagination.pages > 1 %}
        <div class="card-body border-top py-3">
            {{ include('_pagination.html.twig', {pagination: pagination, route: 'order_index'}) }}
        </div>
    {% endif %}
</div>
{% endblock %}
