{% extends 'base.html.twig' %}

{% block title %}Expenses{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Expenses</h1>
    <div>
        <a href="{{ path('expense_category_index') }}" class="btn btn-outline-secondary me-1">Categories</a>
        <a href="{{ path('expense_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New expense</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('expense_index') }}" class="row g-2 align-items-end">
            <div class="col-auto">
                <label for="month" class="form-label small mb-1">Month</label>
                <input type="month" id="month" name="month" value="{{ month }}" class="form-control form-control-sm">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                    <th>Recorded by</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for expense in expenses %}
                    <tr>
                        <td>{{ expense.date|date('Y-m-d') }}</td>
                        <td>{{ expense.category.name }}</td>
                        <td>{{ expense.description ?? '—' }}</td>
                        <td class="text-end">{{ expense.amount|money }}</td>
                        <td>{{ expense.createdBy.fullName }}</td>
                        <td class="text-end">
                            <form action="{{ path('expense_delete', {'id': expense.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Delete this expense?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_expense_' ~ expense.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-4">No expenses for {{ month }}.</td></tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="3" class="text-end">Total</td>
                    <td class="text-end">{{ total|money }}</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
{% endblock %}
