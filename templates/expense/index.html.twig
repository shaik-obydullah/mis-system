{% extends 'base.html.twig' %}

{% block title %}Expenses{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="page-heading mb-0">
        <h1 class="h3">Expenses</h1>
        <p class="lead">{{ month }} · {{ pagination.total }} record(s)</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('expense_category_index') }}" class="btn btn-outline-secondary"><i class="bi bi-tag me-1"></i>Categories</a>
        <a href="{{ path('expense_export', {'month': month, 'q': q}) }}" class="btn btn-outline-secondary"><i class="bi bi-download me-1"></i>Export CSV</a>
        <a href="{{ path('expense_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New expense</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('expense_index') }}" class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label for="month" class="form-label small mb-1">Month</label>
                <input type="month" id="month" name="month" value="{{ month }}" class="form-control">
            </div>
            <div class="col-6 col-md-5">
                <label for="q" class="form-label small mb-1">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="q" name="q" value="{{ q }}" class="form-control" placeholder="Description or category…">
                </div>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">Filter</button>
                <a href="{{ path('expense_index') }}" class="btn btn-outline-secondary">Reset</a>
            </div>
            <div class="col-6 col-md-2 d-flex justify-content-end align-items-center">
                <span class="text-muted small">Total</span>
                <span class="fs-5 fw-bold ms-2 text-danger">{{ total|money }}</span>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                    <th>Recorded by</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for expense in expenses %}
                    <tr>
                        <td>{{ expense.date|date_fmt }}</td>
                        <td>{{ expense.category.name }}</td>
                        <td>{{ expense.description ?? '—' }}</td>
                        <td class="text-end fw-semibold">{{ expense.amount|money }}</td>
                        <td>{{ expense.createdBy.fullName }}</td>
                        <td class="text-end">
                            <form action="{{ path('expense_delete', {'id': expense.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Delete this expense?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_expense_' ~ expense.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-4">No expenses for {{ month }}.</td></tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="3" class="text-end">Total</td>
                    <td class="text-end text-danger">{{ total|money }}</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
    {% if pagination.pages > 1 %}
        <div class="card-body border-top py-3">
            {{ include('_pagination.html.twig', {pagination: pagination, route: 'expense_index'}) }}
        </div>
    {% endif %}
</div>
{% endblock %}
